echo "Building JS assets before push..."
pnpm run build

echo "Building CSS assets before push..."
bundle exec rails tailwindcss:build

echo "#check signatures are up to date"
bundle exec sentinel check

echo "Running rubocop..."
bundle exec rubocop

echo "Running archspec..."
bundle exec archspec check

echo "Running steep type check..."
# Each worker loads the full RBS env (~250MB); default is one per CPU.
# Git exports GIT_INDEX_FILE to hooks. Steep may install the RBS collection,
# whose `git reset --hard` in its own cache repo would then overwrite this
# repository's index with foreign entries and fail the commit.
env -u GIT_INDEX_FILE bundle exec steep check --jobs 2

echo "Running brakeman..."
bundle exec brakeman --no-pager

echo "Running rspec (unit; headless-Chrome :js specs run in CI only)..."
bundle exec rspec --tag '~js'
