# Keep secrets, local state and dev-only files out of the build context.
# See https://docs.docker.com/engine/reference/builder/#dockerignore-file

/.git
/.gitattributes
/.gitignore

# Secrets
/.env*
/config/*.key
**/credentials.json
**/*token.yaml

# Local state
/storage/*
!/storage/.keep
/tmp/*
!/tmp/.keep
/log/*
!/log/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Dependencies and tooling output
**/node_modules
/.pnpm-store
/coverage
/.mutant
/.rigor
/.gem_rbs_collection

# Dev-only
/spec
/e2e
/.agents
/.claude
/.sandbox
/sandbox
/.husky
/.zed

# Docker
/Dockerfile
/compose.yaml
/.dockerignore
