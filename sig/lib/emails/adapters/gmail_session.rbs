module Emails
  module Adapters
    class GmailSession
      APPLICATION_NAME: String
      SCOPE: Array[String]

      @credentials_path: String
      @token_path: String

      def self.setup: (?gmail_options) -> void
      def self.test_connection: (?gmail_options) -> void
      def self.reset: () -> void
      def self.from_env: (?gmail_options) -> GmailAdapter
      def self.paths_from_env: (gmail_options opts) -> { credentials_path: String, token_path: String }

      def initialize: (credentials_path: String, token_path: String) -> void
      def authorize: (?interactive: bool) -> Signet::OAuth2::Client
      def auth: () -> GmailAuth
    end
  end
end
