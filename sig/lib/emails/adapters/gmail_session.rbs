module Emails
  module Adapters
    class GmailSession
      APPLICATION_NAME: String
      SCOPE: Array[String]

      @credentials_path: String
      @token_path: String

      def self.setup: () -> void
      def self.test_connection: () -> String
      def self.reset: () -> void
      def self.from_env: () -> GmailAdapter
      def self.auth_from_env: () -> GmailAuth
      def self.paths_from_env: () -> { credentials_path: String, token_path: String }
      def self.token_path_from_env: () -> String

      def initialize: (credentials_path: String, token_path: String) -> void
      def authorize: (?interactive: bool) -> Signet::OAuth2::Client
      def auth: () -> GmailAuth
    end
  end
end
