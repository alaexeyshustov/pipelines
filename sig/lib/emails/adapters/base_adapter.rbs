module Emails
  module Adapters
    class BaseAdapter
      def self.from_env: (?options) -> instance
      def self.setup: (?options) -> void
      def self.test_connection: (?options) -> void
      def self.reset: () -> void

      def on_exit: () -> void
      def on_init: () -> void
      def search_messages: (String query, ?max_results: Integer, ?offset: Integer, ?label: String?) -> Array[message]
      def list_messages: (?max_results: Integer, ?after_date: Date?, ?before_date: Date?, ?offset: Integer, ?label: String?) -> Array[message]
      def message: (String | Integer message_id, ?label: String?) -> message
      def labels: () -> Array[label]
      def unread_count: () -> Integer
      def modify_labels: (String | Integer message_id, ?add: Array[String], ?remove: Array[String], ?source_mailbox: String?) -> modify_result
      def create_label: (name: String) -> label
      def attachment: (String | Integer message_id, String attachment_id) -> String
      def attachments: (String | Integer message_id) -> Array[attachment]
      def profile: () -> { email_address: String, history_id: String }
      def inbox_message_ids_since: (String history_id) -> Array[String]
      def inbox_message_ids_after: (Date date) -> Array[String]
      def fetch_message: (String | Integer message_id) -> full_message
      def account: () -> String
      def inbox_status: () -> ImapInboxReader::Status
      def inbox_uids_after: (Integer last_uid) -> Array[Integer]
      def inbox_uids_since: (Date date) -> Array[Integer]
    end
  end
end
