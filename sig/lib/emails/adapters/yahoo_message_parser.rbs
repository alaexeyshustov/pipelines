module Emails
  module Adapters
    class YahooMessageParser
      @uid: Integer
      @mail: Mail::Message
      @mailbox: String

      def initialize: (Integer uid, Mail::Message mail, String mailbox) -> void
      def to_h: () -> message
      def to_message: () -> message

      private

      def fields: () -> { id: String, provider: String, subject: String, from: String, to: String, date: String, labels: Array[String] }

      def decode_subject: () -> String
      def format_addresses: (String | Array[String] | nil addresses) -> String
    end
  end
end
