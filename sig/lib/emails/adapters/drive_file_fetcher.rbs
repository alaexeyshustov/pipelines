module Emails
  module Adapters
    class DriveFileFetcher
      class Error < StandardError
      end

      class NotConfigured < Error
      end

      class File
        attr_reader data: String
        attr_reader filename: String
        attr_reader mime_type: String

        def self.new: (data: String, filename: String, mime_type: String) -> instance
      end

      SCOPE: Array[String]
      BASE_URL: String

      def self.from_env: () -> DriveFileFetcher
      def self.token_provider: (GmailAuth auth) -> ^() -> String

      @access_token: ^() -> String

      def initialize: (access_token: ^() -> String) -> void
      def fetch: (String file_id) -> File

      private

      def request: (URI::Generic uri) -> Net::HTTPResponse
      def get: (String file_id, **String | bool params) -> String
    end
  end
end
