module Emails
  class GmailAuth
    class InteractiveAuthorizationRequired < StandardError
    end

    class CallbackTimeout < StandardError
    end

    class InvalidState < StandardError
    end

    class MissingCode < StandardError
    end

    USER_ID: String
    ACCEPT_TIMEOUT: Integer

    @credentials_path: String
    @token_path: String
    @scope: Array[String]
    @output: IO
    @accept_timeout: Integer | Float

    def initialize: (credentials_path: String, token_path: String, scope: Array[String], ?output: IO, ?accept_timeout: Integer | Float) -> void
    def credentials: (?interactive: bool) -> Signet::OAuth2::Client
    def authorization_url: (callback_uri: String, state: String) -> String
    def exchange_code: (code: String, callback_uri: String) -> Signet::OAuth2::Client

    private

    def stored_credentials: () -> Signet::OAuth2::Client
    def interactive_credentials: () -> Signet::OAuth2::Client
    def perform_interactive_auth: (Google::Auth::UserAuthorizer authorizer, TCPServer tcp_server, String callback_uri) -> Signet::OAuth2::Client
    def announce: (*String lines) -> void
    def require_interactive_auth!: (String url) -> void
    def secure_token_file: (writable: bool) -> void
    def build_authorizer: (callback_uri: String, ?writable: bool) -> Google::Auth::UserAuthorizer
    def token_store: (writable: bool) -> Google::Auth::Stores::FileTokenStore
    def interactive_authorization_allowed?: () -> bool
    def open_authorization_url: (String) -> bool
  end
end
