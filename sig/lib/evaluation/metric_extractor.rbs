module Evaluation
  class MetricExtractor
    def self.call: (String agent_name) -> Array[Hash[String, String]]

    @agent_name: String

    def initialize: (String? agent_name) -> void
    def call: () -> Array[Hash[String, String]]

    private

    def load_prompt!: () -> Prompt
    def clean: (Hash[String, json_object_value] entry) -> Hash[String, String]?
    def metrics_from: (RubyLLM::Message response) -> Array[Hash[String, String]]
  end
end
