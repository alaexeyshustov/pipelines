module Orchestration
  module Executors
    class EmailsEmbed
      include Executable
      extend Executable::ClassMethods
      include PerRecord

      type output = { "embedded" => Array[Integer], "skipped" => Array[Integer], "failed" => Array[json_object] }

      @email_ids: Array[Integer]

      def self.call: (email_ids: Array[Integer], **json_object_value) -> output

      def initialize: (email_ids: Array[Integer], **json_object_value) -> void
      def execute: () -> output

      private

      def unembedded: () -> ActiveRecord::Relation
    end
  end
end
