module ActiveRecord
  class Relation
    # The collection's generated signature takes only a Symbol; Relation#exists? also takes conditions.
    def exists?: (*top) -> bool
               | ...
  end

  class Base
    # has_secure_password (bcrypt) and authenticate_by are not in the collection's ActiveRecord signatures.
    def self.has_secure_password: (?Symbol attribute, ?validations: bool, ?reset_token: bool | Integer) -> void
    def self.authenticate_by: (Hash[Symbol, String] | ActionController::Parameters attributes) -> instance?
  end
end
