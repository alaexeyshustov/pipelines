module Evaluation
  class ExperimentDetailComponent < ViewComponent::Base
    type header_action = { type: Symbol, label: String, url: String, variant: Symbol, ?method: Symbol }

    @dataset_samples: Array[DatasetSample]?
    @experiment: Experiment

    @judge_model: String?
    @per_metric_avg: Hash[String, Float]?

    @metrics: Array[Metric]
    @sample_count: Integer
    @metric_weights: Hash[String?, Float]?
    @usage: ExperimentUsageQuery::Usage?
    @pass_rate: Float?
    @metric_pass_rates: Hash[String, Float]
    @active_prompt: PromptDiffer::promptish?

    def initialize: (experiment: Experiment, metrics: Array[Metric], sample_count: Integer, ?usage: ExperimentUsageQuery::Usage?, ?pass_rate: Float?, ?metric_pass_rates: Hash[String, Float], ?active_prompt: PromptDiffer::promptish?) -> void

    def before_render: () -> void
    def metrics: () -> Array[Metric]
    def sample_count: () -> Integer
    def active_prompt: () -> PromptDiffer::promptish?
    def prompt_active?: () -> bool
    def active_prompt_diff?: () -> bool
    def per_metric_avg: () -> Hash[String, Float]
    def overall_avg: () -> Float?
    def overall_label: () -> String
    def pass_rate_label: () -> String?
    def usage?: () -> bool
    def cost_label: () -> String
    def tokens_label: () -> String?
    def models_label: () -> String?
    def progress_label: () -> String?
    def newer_experiment_active?: () -> bool
    def dataset_samples: () -> Array[DatasetSample]
    def judge_model: () -> String
    def output_schema_json: () -> String

    private

    def metric_weights: () -> Hash[String?, Float]

    def setup_header: () -> void
    def header_actions: () -> Array[header_action]
    def improve_action: () -> header_action?
    def activate_action: () -> header_action?
    def comparison_action: () -> header_action?
    def setup_metric_rows: () -> void
  end
end
