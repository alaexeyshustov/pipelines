module UI
  class ActionComponent
    class DialogComponent < ViewComponent::Base
      def initialize: (
        label: String?,
        dialog_title: String?,
        url: String?,
        ?method: Symbol,
        ?confirm_label: String,
        ?variant: ActionComponent::action_variant?,
        ?size: :sm | :md,
        ?body_component: singleton(ViewComponent::Base)?,
        ?body_options: Hash[Symbol, ActionComponent::body_component_options]
      ) -> void

      def with_body: () { (ActionView::Helpers::FormBuilder) -> void } -> self
      def body?: () -> bool
      def render_body: (?ActionView::Helpers::FormBuilder?) -> String

      def trigger_classes: () -> String
      def cancel_classes: () -> String
      def confirm_classes: () -> String
      def dialog_css: () -> String
    end
  end
end
