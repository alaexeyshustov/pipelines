module UI
  class ActionComponent < ViewComponent::Base
    type action_type = :link | :button | :delete | :dialog | :raw
    type action_variant = :primary | :secondary | :neutral | :danger | :success | :ghost

    type body_component_options = { ?schema: json_object?, ?name_prefix: String }

    TYPES: Array[Symbol]
    VARIANT_CLASSES: Hash[Symbol, String]
    CONFIRM_VARIANT_CLASSES: Hash[Symbol, String]
    BASE_CLASSES: String
    LINK_CLASSES: String
    BUTTON_CLASSES: String
    DELETE_CLASSES: String

    @type: action_type
    @label: String?
    @url: String?
    @confirm: String?
    @confirm_label: String?
    @method: Symbol?
    @variant: action_variant?
    @dialog_title: String?
    @size: :sm | :md
    @body_component: singleton(ViewComponent::Base)?
    @body_options: Hash[Symbol, body_component_options]

    def initialize: (
      ?type: action_type,
      ?label: String?,
      ?url: String?,
      ?confirm: String?,
      ?method: Symbol?,
      ?variant: action_variant?,
      ?dialog_title: String?,
      ?confirm_label: String?,
      ?size: :sm | :md,
      ?body_component: singleton(ViewComponent::Base)?,
      ?body_options: Hash[Symbol, body_component_options]
    ) -> void

    def call: () -> String

    private

    def subcomponent: () -> ViewComponent::Base
    def dialog_component: () -> DialogComponent
  end
end
