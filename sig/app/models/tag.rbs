class Tag < ApplicationRecord
  NAMES: Array[String]
  STARTER_SUBTAGS: Hash[String, Array[String]]

  def self.seed_defaults!: () -> void
  def self.seed_subtags: (Tag tag, Array[String] names, Set[[Integer, String]] known) -> void

  def id: () -> Integer
  def name: () -> String?
  def name=: (String?) -> String?
  def subtags: () -> ActiveRecord::Associations::CollectionProxy
  def taggings: () -> ActiveRecord::Associations::CollectionProxy
end
