class DocumentDuplicate < ApplicationRecord
  def document: () -> Document
  def document=: (Document) -> Document
  def document_id: () -> Integer
  def duplicate: () -> Document
  def duplicate=: (Document) -> Document
  def duplicate_id: () -> Integer
  def similarity: () -> Float
  def similarity=: (Float) -> Float
  def status: () -> String
  def pending?: () -> bool
  def confirmed?: () -> bool
  def dismissed?: () -> bool
  def confirmed!: () -> bool
  def dismissed!: () -> bool

  def self.involving: (Document document) -> ActiveRecord::Relation
  def self.candidates_for: (Document document) -> ActiveRecord::Relation
  def self.flag!: (Document first, Document second, similarity: Float) -> DocumentDuplicate

  def other: (Document from) -> Document

  private

  def distinct_documents: () -> void
end
