class Embedding < ApplicationRecord
  def self.store!: (ApplicationRecord embeddable, model: String, content_digest: String, vector: Array[Float]) -> Embedding
  def self.nearest: (Array[Float] vector, type: String, model: String, ?scope: ActiveRecord::Relation, ?limit: Integer) -> ActiveRecord::Relation

  def neighbor_distance: () -> Float
  def nearest_neighbors: (Symbol attribute, distance: String, ?threshold: Float) -> ActiveRecord::Relation
  def vector: () -> Array[Float]
  def embeddable: () -> ApplicationRecord
  def model: () -> String
  def dimensions: () -> Integer
  def content_digest: () -> String
  def embedded_at: () -> Time

  private

  def vector_not_zero: () -> void
end
