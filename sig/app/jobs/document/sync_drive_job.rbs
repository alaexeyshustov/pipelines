class Document
  class SyncDriveJob < ApplicationJob
    type summary = Hash[String, Integer]

    SETTING_KEY: String

    @summary: summary
    @queued_tagging: Array[Integer]

    def self.folder_ids: () -> Array[String]

    def perform: () -> summary

    private

    def summary: () -> summary
    def sync_all: (Emails::Adapters::DriveFileFetcher fetcher, Array[String] folder_ids) -> void
    def stored: (Document document, String outcome) -> void
    def queue_tagging: (Integer document_id) -> void
    def queued_tagging: () -> Array[Integer]
    def requeue_untagged: () -> void
    def merge_into_existing: (Document? document) -> void
    def relink: (Document document, Document::DriveEntry drive_entry) -> void
    def known_bytes?: (String checksum, Document::DriveEntry drive_entry, Document? document, Hash[String, Document] gone) -> bool
    def gone_documents: (Hash[String?, Document] existing, Array[Emails::Adapters::DriveFileFetcher::Entry] entries, Array[String] empty_folder_ids) -> Hash[String, Document]
    def store: (Hash[Symbol, String | Hash[Symbol, String?]?] attributes, Document? document) -> void
    def sync: (Emails::Adapters::DriveFileFetcher fetcher, Emails::Adapters::DriveFileFetcher::Entry entry, Document? document, Hash[String, Document] gone) -> void
    def process: (Emails::Adapters::DriveFileFetcher fetcher, Document::DriveEntry drive_entry, Document? document, Hash[String, Document] gone) -> void
    def warn_empty: (Array[String] folder_ids) -> void
    def delete_missing: (Hash[String, Document] gone, Array[String] empty_folder_ids) -> void
  end
end
