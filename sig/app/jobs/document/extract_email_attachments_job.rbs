class Document
  class ExtractEmailAttachmentsJob < ApplicationJob
    # An attachment whose MIME type was resolved from its declared type and filename; nil when unknown.
    type resolved_attachment = { id: String, filename: String, mime_type: String?, size: Integer }

    def perform: (Integer email_id) -> void

    private

    def eligible?: (Email email) -> bool
    def handle: (Email email, Emails::attachment attachment) -> void
    def with_resolved_type: (Emails::attachment attachment) -> resolved_attachment
    def ingest: (Email email, resolved_attachment attachment, String checksum, String text) -> Document
    def source_ref: (Email email, resolved_attachment attachment) -> Hash[Symbol, String]
    def process: (Email email, resolved_attachment attachment) -> void
  end
end
