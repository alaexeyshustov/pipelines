class GistUploader
  GITHUB_API: String
  API_VERSION: String
  GIST_ID_FORMAT: Regexp

  class Result < Data
    attr_reader url: String?

    def self.new: (url: String?) -> instance
  end

  class ApiError < StandardError
  end

  class InvalidGistId < ApiError
  end

  @token: String
  @gist_id: String?
  @filename: String

  def self.from_env: (filename: String) -> GistUploader
  def self.call: (String content, token: String, ?gist_id: String?, filename: String) -> Result

  def initialize: (token: String, ?gist_id: String?, filename: String) -> void
  def call: (String content) -> Result

  private

  def validate_id: () -> void
  def ensure_secret!: () -> void
  def request: (Symbol method, String path, ?_ToJson? body) -> json_object
  def parse_body: (Net::HTTPResponse res) -> json_object_value
  def build_http_client: (URI::Generic uri) -> Net::HTTP
  def build_http_request: (Symbol method, URI::Generic uri, _ToJson? body) -> (Net::HTTP::Get | Net::HTTP::Post | Net::HTTP::Patch)
end
