class Email
  class SearchQuery
    class Hit
      attr_reader email: Email
      attr_reader rank: Float
      attr_reader snippet: String?

      def self.new: (email: Email, rank: Float, snippet: String?) -> instance
    end

    class Result < Data
      attr_reader hits: Array[Hit]

      def self.new: (hits: Array[Hit]) -> instance
    end

    def self.call: (String? query, ?limit: Integer, ?mode: Symbol) -> Result

    @query: String?
    @limit: Integer
    @mode: Symbol

    def initialize: (String? query, limit: Integer, mode: Symbol) -> void
    def call: () -> Result
  end
end
