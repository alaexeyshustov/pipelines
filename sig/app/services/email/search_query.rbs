class Email
  class SearchQuery
    class Hit
      attr_reader email: Email
      attr_reader rank: Float
      attr_reader snippet: String?

      def self.new: (email: Email, rank: Float, snippet: String?) -> instance
    end

    def self.call: (String? query, ?limit: Integer, ?mode: Symbol) -> Array[Hit]

    @query: String?
    @limit: Integer
    @mode: Symbol

    def initialize: (String? query, limit: Integer, mode: Symbol) -> void
    def call: () -> Array[Hit]
  end
end
