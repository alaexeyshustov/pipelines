module Evaluation
  class Sampler
    WRITE_BLOCKED_SENTINEL: String

    type tool_call = { "tool_name" => String, "arguments" => json_object, "result" => String }

    @experiment: Experiment
    @dataset_sample: DatasetSample
    @prompt: Prompt?

    def self.call: (experiment: Experiment, dataset_sample: DatasetSample, prompt: Prompt?) -> Sample

    def initialize: (experiment: Experiment, dataset_sample: DatasetSample, prompt: Prompt?) -> void

    def call: () -> Sample

    private

    def task_class: () -> singleton(RubyLLM::Evaluation)
    def build_agent: () -> RubyLLM::Agent
    def persist_sample: (RubyLLM::Evaluation::Trial trial) -> Sample
    def tool_calls_from: (json_object? evidence) -> Array[tool_call]
    def index_calls: (Array[json_object] messages) -> Hash[String, json_object]
    def wrap_write_tools: (Array[singleton(RubyLLM::Tool)] tool_classes) -> Array[singleton(RubyLLM::Tool)]
    def block_write_tool: (singleton(RubyLLM::Tool) tool_class) -> singleton(RubyLLM::Tool)
  end
end
