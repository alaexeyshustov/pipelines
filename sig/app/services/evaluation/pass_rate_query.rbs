module Evaluation
  class PassRateQuery
    PASS_RATE: Arel::Nodes::SqlLiteral

    class Result < Data
      attr_reader by_experiment: Hash[Integer, Float]

      def self.new: (by_experiment: Hash[Integer, Float]) -> instance
    end

    @experiment_ids: Array[Integer]

    def self.call: (experiment_ids: Array[Integer]) -> Result
    def initialize: (experiment_ids: Array[Integer]) -> void
    def call: () -> Result
  end
end
