class Document
  class SearchQuery
    class Hit
      attr_reader document: Document
      attr_reader rank: Float?
      attr_reader snippet: String?

      def self.new: (document: Document, rank: Float?, snippet: String?) -> instance
    end

    def self.call: (String? query, ?limit: Integer, ?mode: Symbol) -> Array[Hit]

    @query: String?
    @limit: Integer
    @mode: Symbol

    def initialize: (String? query, limit: Integer, mode: Symbol) -> void
    def call: () -> Array[Hit]

    private

    def text_hits: () -> Array[Hit]
    def semantic_hits: () -> Array[Hit]
    def hybrid_hits: () -> Array[Hit]
  end
end
