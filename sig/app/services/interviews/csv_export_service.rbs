module Interviews
  class CsvExportService
    FORMULA_PREFIX: Regexp

    class Result < Data
      attr_reader csv: String

      def self.new: (csv: String) -> instance
    end

    @ids: Array[String] | Array[Integer] | nil
    @columns: Array[String]

    def self.call: (ids: Array[String] | Array[Integer] | nil) -> Result

    def initialize: (ids: Array[String] | Array[Integer] | nil) -> void
    def call: () -> Result

    private

    def sanitize: (String | Date | nil value) -> (String | Date | nil)
    def scope: () -> Interview::relation
  end
end
