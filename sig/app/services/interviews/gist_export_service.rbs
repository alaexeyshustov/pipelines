module Interviews
  class GistExportService
    class Result
      attr_reader ok: bool
      attr_reader message: String

      def initialize: (ok: bool, message: String) -> void
      def ok?: () -> bool
    end

    @ids: Array[String] | Array[Integer] | nil

    def self.call: (ids: Array[String] | Array[Integer] | nil) -> Result

    def initialize: (ids: Array[String] | Array[Integer] | nil) -> void
    def call: () -> Result
  end
end
