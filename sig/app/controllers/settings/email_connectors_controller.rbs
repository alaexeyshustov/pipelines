module Settings
  class EmailConnectorsController < ApplicationController
    FILE_QUOTING_ERRORS: Array[singleton(StandardError)]

    @email_connectors: EmailConnector::relation
    @email_connector: EmailConnector?

    def index: () -> void
    def new: () -> void
    def edit: () -> void
    def create: () -> void
    def update: () -> void
    def destroy: () -> void
    def test: () -> void
    def setup: () -> void
    def oauth_callback: () -> void

    private

    def log_setup_failure: (StandardError error) -> void
    def oauth_state_valid?: (String? expected) -> bool
    def oauth_rejection: (ActiveSupport::HashWithIndifferentAccess[String, String | Integer] oauth) -> [ String, String ]?
    def oauth_state_problem: (String | Integer | nil expected) -> String
    def reject_oauth: (String message, String reason) -> void
    def exchange_gmail_code: () -> void
    def oauth_failed: (String message) -> void
    def set_email_connector: () -> void
    def require_gmail_connector: () -> void
    def email_connector_params: () -> ActionController::Parameters
  end
end
