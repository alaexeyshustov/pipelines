module Orchestration
  class SchemaBuildersController < ApplicationController
    @builder: Orchestration::SchemaBuilder
    @json: String
    @error: String?

    def build: () -> void
    def add_property: () -> void
    def remove_property: () -> void
    def change_type: () -> void
    def parse: () -> void

    private

    def render_mutation: () { (Orchestration::SchemaBuilder) -> Orchestration::SchemaBuilder } -> void
    def render_builder: (Orchestration::SchemaBuilder builder) -> void
    def render_parse_error: (String message) -> void
    def parsed_root: () -> Orchestration::SchemaBuilder
    def property_name: () -> String
    def parse_json: () -> json_object
    def parse_path: () -> Array[String]
    def builder_params: () -> ActionController::Parameters
  end
end
