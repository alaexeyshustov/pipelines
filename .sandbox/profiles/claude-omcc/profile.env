# Sourced by bin/attach-worktree. $HOME and $primary_repo_root are set by the
# caller before this file is sourced.
#
# Claude Code authentication is a long-lived OAuth token, not a reusable file.
# Generate it once per host with:
#   claude setup-token
# and save the printed token as the sole contents of:
#   ~/.claude-container/oauth-token

SANDBOX_AGENT_HOME_VOLUME="pipelines-claude-omcc-home"
SANDBOX_AGENT_HOME_CONTAINER_PATH="/root/.claude"
SANDBOX_AUTH_HOST_PATH="$HOME/.claude-container/oauth-token"
SANDBOX_AUTH_CONTAINER_PATH="/run/host-claude/oauth-token"
