{
  "permissions": {
    "deny": [
      "Read(**/credentials.json)",
      "Read(**/*token.yaml)",
      "Read(**/config/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/claude-hooks/guard-bash"
          }
        ]
      }
    ]
  }
}
