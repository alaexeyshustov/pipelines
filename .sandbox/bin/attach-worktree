#!/usr/bin/env bash

set -euo pipefail

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: .sandbox/bin/attach-worktree [issue-or-scratch-name] [profile] [--profile=<name>]

profile defaults to claude-matt. Available profiles live as directories under
.sandbox/profiles/.
USAGE
}

for command in git podman ruby; do
  command -v "$command" >/dev/null || fail "Required command not found: $command"
done

profile=""
positional=()
for arg in "$@"; do
  case "$arg" in
    --profile=*) profile="${arg#--profile=}" ;;
    --profile) fail "--profile requires a value, e.g. --profile=claude-matt" ;;
    -h|--help) usage; exit 0 ;;
    *) positional+=("$arg") ;;
  esac
done
[[ ${#positional[@]} -le 2 ]] || { usage >&2; exit 2; }

identifier="${positional[0]:-}"
[[ -n "$profile" ]] || profile="${positional[1]:-claude-matt}"
[[ "$profile" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "Invalid profile name: $profile"

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# Where the user is, not where this script lives: the helpers are usually run
# from the primary checkout's copy, including from inside a worktree.
invocation_repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
script_git_common_dir="$(git -C "$script_dir" rev-parse --path-format=absolute --git-common-dir)"
primary_repo_root="$(dirname "$script_git_common_dir")"


db_helper="$primary_repo_root/.sandbox/bin/db_helper"
profiles_root="$primary_repo_root/.sandbox/profiles"
profile_dir="$profiles_root/$profile"
profile_env="$profile_dir/profile.env"

[[ -x "$db_helper" ]] || fail "Database helper is not executable: $db_helper"
[[ -d "$profile_dir" ]] || fail "Unknown sandbox profile: $profile (expected a directory under .sandbox/profiles/)"
[[ -f "$profile_env" ]] || fail "Profile is missing profile.env: $profile_env"

if [[ "$identifier" =~ ^#?([0-9]+)$ || "$identifier" =~ ^[Gg][Hh]-([0-9]+)$ || "$identifier" =~ ^https://github\.com/[^/]+/[^/]+/issues/([0-9]+) ]]; then
  identifier="GH-${BASH_REMATCH[1]}"
fi

if [[ -n "$identifier" ]]; then
  worktree_record="$("$db_helper" get_worktree "$identifier")"
elif [[ "$invocation_repo_root" == "$primary_repo_root" ]]; then
  worktree_record="$("$db_helper" get_worktree --latest)"
else
  worktree_record="$("$db_helper" get_worktree --worktree="$invocation_repo_root")"
fi

IFS=$'\t' read -r identifier repo_root ticket <<< "$worktree_record"
[[ -n "$identifier" && -n "$repo_root" ]] \
  || fail "Invalid sandbox worktree registry record. Run init-worktree again."
[[ -d "$repo_root" ]] || fail "Registered worktree no longer exists: $repo_root"
git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null \
  || fail "Registered path is not a Git worktree: $repo_root"
cd "$repo_root"

# A linked worktree's .git file holds an absolute path into its repository's
# common directory, so that directory has to be mounted at the identical path
# for Git to work inside the container. Derive it from the worktree being
# mounted, not from this script's own location: when the toolkit is checked out
# as <application>/.sandbox it is its own repository, and mounting its common
# directory leaves the worktree's gitdir pointer dangling in the container.
git_common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
[[ -d "$git_common_dir" ]] || fail "Git common directory not found: $git_common_dir"

if [[ -n "$ticket" ]]; then
  [[ "$ticket" =~ ^GH-[0-9]+$ ]] || fail "Invalid issue metadata in the sandbox worktree registry"
fi

"$db_helper" register_container "$identifier" "$profile"

# Each sandbox gets its own forwarded host port: several containers run at
# once, so a single fixed port would collide. The registry owns the
# allocation so the port stays stable across restarts.
host_port="$("$db_helper" container_port "$identifier" --profile="$profile")"
[[ "$host_port" =~ ^[0-9]+$ ]] \
  || fail "Sandbox registry returned an invalid forwarded host port: $host_port"

worktree_name="$(basename "$repo_root")"
container_name="pipelines-${profile}-${worktree_name}"
[[ "$container_name" =~ ^pipelines-[a-z0-9-]+$ ]] \
  || fail "Invalid computed sandbox container name: $container_name"

# shellcheck disable=SC1090
source "$profile_env"
[[ -n "${SANDBOX_AGENT_HOME_VOLUME:-}" ]] || fail "profile.env did not set SANDBOX_AGENT_HOME_VOLUME"
[[ -n "${SANDBOX_AGENT_HOME_CONTAINER_PATH:-}" ]] || fail "profile.env did not set SANDBOX_AGENT_HOME_CONTAINER_PATH"
[[ -n "${SANDBOX_AUTH_HOST_PATH:-}" ]] || fail "profile.env did not set SANDBOX_AUTH_HOST_PATH"
[[ -n "${SANDBOX_AUTH_CONTAINER_PATH:-}" ]] || fail "profile.env did not set SANDBOX_AUTH_CONTAINER_PATH"
[[ -f "$SANDBOX_AUTH_HOST_PATH" ]] || fail "Host authentication not found for profile $profile: $SANDBOX_AUTH_HOST_PATH"

# Worktree copies of the profile files can lag behind the primary checkout.
# Always build from the primary copy so fixes apply to every existing
# worktree on its next attach.
lib_dir="$profiles_root/lib"

# Sandboxes run as amd64, under Rosetta on Apple Silicon. sqlite-vec ships its
# Linux ARM gem tagged arm64-linux, which Linux Ruby (aarch64-linux) never
# selects, so the app cannot bundle on native arm64. The architecture is part
# of the image tag and of the dependency volume names, so images and installed
# gems/node_modules from another architecture are never reused.
sandbox_arch="amd64"
sandbox_platform="linux/$sandbox_arch"
bundle_volume="${container_name}-bundle-${sandbox_arch}"
node_modules_volume="${container_name}-node-modules-${sandbox_arch}"
pnpm_store_volume="pipelines-sandbox-pnpm-store"

[[ -f "$profile_dir/Containerfile" ]] || fail "Profile image definition not found: $profile_dir/Containerfile"
[[ -d "$lib_dir" ]] || fail "Shared profile library not found: $lib_dir"

# The GitHub CLI in the image needs host credentials. They cannot be mounted
# like the Claude OAuth token: `gh auth login` stores the token in the macOS
# keyring, leaving no token in ~/.config/gh. Ask gh for it and hand it over
# through the environment -- exported rather than passed as --env GH_TOKEN=...
# so the token never appears in this process's command line.
gh_token_mount=()
if command -v gh >/dev/null; then
  GH_TOKEN="$(gh auth token 2>/dev/null || true)"
  if [[ -n "$GH_TOKEN" ]]; then
    export GH_TOKEN
    gh_token_mount+=(--env GH_TOKEN)
  else
    printf 'Warning: host gh has no token; `gh` will be unauthenticated in the sandbox.\n' >&2
    printf '         Run `gh auth login` on the host to fix this.\n' >&2
  fi
else
  printf 'Warning: gh is not installed on the host; `gh` will be unauthenticated in the sandbox.\n' >&2
fi

directory_fingerprint() {
  local dir
  for dir in "$@"; do
    find "$dir" -type f -exec sha256sum {} +
  done | LC_ALL=C sort | sha256sum | awk '{print $1}'
}

image_tag="pipelines-${profile}-agent-${sandbox_arch}:$(directory_fingerprint "$profile_dir" "$lib_dir")"
launch_config_tag="$(cksum "${BASH_SOURCE[0]}" | awk '{print $1 "-" $2}')"

if ! podman image exists "$image_tag"; then
  printf 'Building %s agent image: %s\n' "$profile" "$image_tag"
  podman build --platform "$sandbox_platform" --tag "$image_tag" \
    --file "$profile_dir/Containerfile" \
    --build-context "lib=$lib_dir" \
    "$profile_dir"
fi

container_status="$(podman container inspect --format '{{.State.Status}}' "$container_name" 2>/dev/null || true)"
container_image_tag="$(podman container inspect --format '{{index .Config.Labels "io.pipelines.sandbox.agent-image"}}' "$container_name" 2>/dev/null || true)"
container_launch_config_tag="$(podman container inspect --format '{{index .Config.Labels "io.pipelines.sandbox.launch-config"}}' "$container_name" 2>/dev/null || true)"

if [[ "$container_status" =~ ^(exited|created)$ ]] \
  && { [[ "$container_image_tag" != "$image_tag" ]] || [[ "$container_launch_config_tag" != "$launch_config_tag" ]]; }; then
  printf 'Recreating stopped sandbox container with the current configuration: %s\n' "$container_name"
  podman container rm "$container_name"
  container_status=""
elif [[ "$container_status" == running ]] \
  && { [[ "$container_image_tag" != "$image_tag" ]] || [[ "$container_launch_config_tag" != "$launch_config_tag" ]]; }; then
  printf 'Replacing running sandbox container with the current configuration: %s\n' "$container_name"
  podman container stop --time 20 "$container_name"
  podman container rm "$container_name"
  container_status=""
fi

"$db_helper" update_container_status "$identifier" active --profile="$profile"

# The agent is a full-screen TUI: it puts this terminal into raw mode, the
# alternate screen, and application cursor-key mode. When it dies without
# emitting its own restore sequences -- a crash, a dropped attach, a killed
# container -- the shell we return to is left in raw mode, where navigation
# keys echo as stray symbols. Save the terminal before handing it over and
# restore it afterwards, which rules out exec'ing podman.
saved_terminal_state=""

restore_terminal() {
  [[ -n "$saved_terminal_state" ]] || return 0

  stty "$saved_terminal_state" 2>/dev/null || stty sane 2>/dev/null || true
  if [[ -t 1 ]]; then
    # Leave the alternate screen, restore normal cursor keys and keypad, show
    # the cursor, stop mouse reporting, and reset the scroll region/attributes.
    printf '\033[?1049l\033[?1l\033>\033[?25h\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[r\033[0m'
  fi
  saved_terminal_state=""
}

run_agent_container() {
  local status=0

  # Nothing to protect when the terminal is not ours to begin with.
  if [[ ! -t 0 ]]; then
    "$@"
    return
  fi

  saved_terminal_state="$(stty -g)"
  trap restore_terminal EXIT HUP INT TERM
  "$@" || status=$?
  restore_terminal
  trap - EXIT HUP INT TERM

  return "$status"
}

container_status_code=0

printf 'Forwarding http://127.0.0.1:%s to the sandbox port 3000\n' "$host_port"

case "$container_status" in
  running)
    printf 'Attaching to sandbox container: %s\n' "$container_name"
    run_agent_container podman attach "$container_name" || container_status_code=$?
    exit "$container_status_code"
    ;;
  exited|created)
    printf 'Restarting sandbox container: %s\n' "$container_name"
    run_agent_container podman start --interactive --attach "$container_name" \
      || container_status_code=$?
    exit "$container_status_code"
    ;;
  '')
    printf 'Launching sandbox container: %s\n' "$container_name"
    run_agent_container podman run --interactive --tty \
      --platform "$sandbox_platform" \
      --name "$container_name" \
      --label "io.pipelines.sandbox.agent-image=$image_tag" \
      --label "io.pipelines.sandbox.launch-config=$launch_config_tag" \
      --label "io.pipelines.sandbox.profile=$profile" \
      --hostname "${container_name:0:63}" \
      --workdir /workspace \
      --env "SANDBOX_WORKTREE_NAME=$worktree_name" \
      --env "SANDBOX_HOST_PORT=$host_port" \
      --env 'BINDING=0.0.0.0' \
      --publish "127.0.0.1:$host_port:3000" \
      "${gh_token_mount[@]+"${gh_token_mount[@]}"}" \
      --mount "type=bind,src=$repo_root,dst=/workspace" \
      --mount "type=bind,src=$git_common_dir,dst=$git_common_dir" \
      --mount "type=volume,src=$bundle_volume,dst=/bundle" \
      --mount "type=volume,src=$node_modules_volume,dst=/workspace/node_modules" \
      --mount "type=volume,src=$pnpm_store_volume,dst=/pnpm/store" \
      --mount "type=volume,src=$SANDBOX_AGENT_HOME_VOLUME,dst=$SANDBOX_AGENT_HOME_CONTAINER_PATH" \
      --mount "type=bind,src=$SANDBOX_AUTH_HOST_PATH,dst=$SANDBOX_AUTH_CONTAINER_PATH,ro" \
      "$image_tag" ${ticket:+"$ticket"} \
      || container_status_code=$?
    exit "$container_status_code"
    ;;
  *)
    fail "Unexpected sandbox container state for $container_name: $container_status"
    ;;
esac
