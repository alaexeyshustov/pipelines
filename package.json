{
  "name": "application_pipeline",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "build": "esbuild app/javascript/application.ts --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets",
    "build:watch": "esbuild app/javascript/application.ts --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets --watch",
    "e2e": "playwright test --project=chromium",
    "e2e:ui": "playwright test --ui",
    "screenshots": "playwright test --project=screenshots",
    "lint": "eslint 'app/javascript/**/*.ts'",
    "format": "prettier --write 'app/javascript/**/*.ts'",
    "format:check": "prettier --check 'app/javascript/**/*.ts'",
    "herb:lint": "herb-lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.12",
    "@stimulus-components/dialog": "^1.0.1",
    "chart.js": "^4.5.1",
    "tom-select": "^2.7.0"
  },
  "devDependencies": {
    "@herb-tools/linter": "0.11.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
