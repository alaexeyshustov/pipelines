# Copy to .env.docker for `docker compose up`. Never commit .env.docker.

# Rails (generate with `bin/rails secret`)
SECRET_KEY_BASE=

# Hostnames the app is served on (comma-separated); other Host headers are rejected. Unset allows any host.
APP_HOST=

# Login for the whole app. The seeds create the user when ADMIN_EMAIL is set, but they only run when
# db:prepare creates the database. On an existing `storage` volume (or to change the password later),
# run `docker compose run --rm web bin/rails users:upsert`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM — at least one required
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: mistral-embed in production, or a local model with `--profile ollama`
EMBEDDING_MODEL=mistral-embed
# OLLAMA_API_BASE=http://ollama:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:0.6b
