<div class="grid grid-cols-2 gap-3" data-metric-definition-fields>
  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1">Kind</label>
    <%= select_tag "evaluation_metric[kind]", options_for_select(kind_options, selected_kind),
          class: "w-full rounded border border-gray-300 px-2 py-1.5 text-sm" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1">Pass threshold (0.0-1.0)</label>
    <%= number_field_tag "evaluation_metric[minimum]", minimum, step: 0.05, min: 0, max: 1,
          class: "w-full rounded border border-gray-300 px-2 py-1.5 text-sm" %>
  </div>
  <div class="col-span-2">
    <label class="block text-xs font-medium text-gray-600 mb-1">Levels</label>
    <%= text_area_tag "evaluation_metric[levels_text]", levels_text, rows: 4,
          class: "w-full rounded border border-gray-300 px-2 py-1.5 text-sm font-mono" %>
    <p class="mt-1 text-xs text-gray-400">
      <%= hints.map { |kind, hint| "#{kind}: #{hint}" }.join(" ") %>
    </p>
  </div>
</div>
