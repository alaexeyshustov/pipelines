<div class="space-y-1">
  <div class="flex items-center gap-2">
    <% if score_label %>
      <span class="text-sm font-semibold text-gray-900"><%= score_label %></span>
    <% end %>
    <% if verdict %>
      <%= render UI::StatusBadgeComponent.new(label: verdict[:label], variant: verdict[:variant]) %>
    <% end %>
    <% if confidence_label %>
      <span class="text-xs text-gray-400">confidence <%= confidence_label %></span>
    <% end %>
  </div>
  <% if raw? %>
    <% if level_label %>
      <p class="text-xs text-gray-600"><%= level_label %></p>
    <% end %>
    <% if probabilities.any? %>
      <p class="text-xs text-gray-400 font-mono">
        <%= probabilities.map { |name, share| "#{name} #{share}" }.join(" · ") %>
      </p>
    <% end %>
  <% end %>
</div>
