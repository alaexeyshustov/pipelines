<%= render UI::PageHeaderComponent.new(title: "Tags", notice: notice, alert: alert) %>

<div class="space-y-4">
  <% @tags.each do |tag_record| %>
    <%= render ::Tags::TagCardComponent.new(tag: tag_record, subtags: tag_record.subtags.sort_by(&:name),
                                          form_url: tag_subtags_path(tag_record), errors: @form_errors[tag_record.id]) %>
  <% end %>
</div>
