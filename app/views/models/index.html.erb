<%= render UI::PageHeaderComponent.new(title: "Models") do |header| %>
  <% header.with_action(type: :button, label: "Sync Models", url: sync_models_path, method: :post, variant: :primary) %>
<% end %>

<%= render UI::SearchFormComponent.new(url: models_path, query: @query, clear_url: models_path) %>

<%= render UI::TableComponent.new(collection: @models, empty_message: "No models found.", pagy: @pagy, filters: @filters) do |table| %>
  <% table.with_columns([
    { key: "id",                       label: "ID",             style: :compact },
    { key: "name",                     label: "Name",           style: :compact },
    { key: "provider",                 label: "Provider",       style: :compact, variant: :subtle },
    { key: "context_window",           label: "Context Window", style: :compact, variant: :subtle },
    { key: "input_price_per_million",  label: "Input $/M",      style: :compact, variant: :subtle, cell: ->(m) { m.price(:input) ? "$#{"%.4f" % m.price(:input)}" : "—" } },
    { key: "output_price_per_million", label: "Output $/M",     style: :compact, variant: :subtle, cell: ->(m) { m.price(:output) ? "$#{"%.4f" % m.price(:output)}" : "—" } },
    { key: "modalities",               label: "Modalities",     style: :compact, variant: :subtle, cell: ->(m) { [ *m.modalities.input, *m.modalities.output ].uniq.join(", ") } }
  ]) %>
<% end %>
